# Скопируйте этот файл в sites/<имя>.caddy и поправьте поддомен и upstream.
# Имя файла должно заканчиваться на .caddy — иначе Caddy его не подключит.
#
# DNS: A/AAAA-запись <поддомен>.<DOMAIN> должна указывать на VPS.
# Контейнер приложения подключается к внешней сети proxy (см. README).

app.{$DOMAIN} {
	import upstream app:3000
}
